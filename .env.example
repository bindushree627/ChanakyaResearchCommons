# Local Environment Configuration for Chanakya Research Commons
# Copy this file to .env for local development. Never commit .env to Git!

FLASK_APP=app:create_app
FLASK_ENV=development
SECRET_KEY=local-dev-secret-key-change-if-needed

# Local SQLite Database (default — zero external services required):
DATABASE_URL=sqlite:///data/chanakya_commons.db

# Semantic Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional Local Ollama Integration for Research Assistant
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# OpenAlex Ingestion Contact
OPENALEX_MAILTO=research@chanakya.ac.in
